# --- Local development ---------------------------------------------------------------------------
# The app runs on Cloudflare D1 (SQLite). Locally the database lives in .wrangler/state; this URL is only a
# placeholder that the Prisma CLI needs to read the schema.
DATABASE_URL="file:./dev.db"

# Secrets for `next dev` / local preview go in .env.development (never in .env, which is bundled on deploy):
#   AUTH_SECRET=...        generate with: npx auth secret   (or: openssl rand -base64 32)
#   AUTH_TRUST_HOST=true
#   APP_URL=http://localhost:3002
#
# Production (Cloudflare Worker) needs these, set with `npx wrangler secret put <NAME>`:
#   AUTH_SECRET            long random string
#   AUTH_URL               https://your-domain   (the public URL of the app)
#   APP_URL                https://your-domain   (used in the voucher QR code, must be reachable from phones)
